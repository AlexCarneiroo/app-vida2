# Copie para functions/.env (não vai para o git).
# Gere o par de chaves com:  cd functions && npm run keys
VAPID_PUBLIC_KEY=
# Um contacto seu (e-mail) — exigido pelo protocolo Web Push.
VAPID_SUBJECT=mailto:voce@exemplo.com
# A chave PRIVADA não fica aqui: guarde-a como segredo:
#   npx firebase-tools functions:secrets:set VAPID_PRIVATE_KEY
